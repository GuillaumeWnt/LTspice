* Sub-Bloc Alim 15V (L7815 + D1 + C1/C2 + R2)
.subckt sub_alim_15v VIN_24V GND VOUT_15V
D1 VIN_24V VIN_FILT 1N4007
C1 VIN_FILT GND 10u
B1 VOUT_15V GND V=limit(V(VIN_FILT,GND)-1.5, 0, 15)
C2 VOUT_15V GND 10u
R2 VOUT_15V GND 2.2k
.model 1N4007 D(IS=7.02e-9 RS=0.034 BV=1000 IBV=0.05u)
.ends sub_alim_15v

