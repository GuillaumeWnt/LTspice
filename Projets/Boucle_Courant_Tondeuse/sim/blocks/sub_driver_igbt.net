* Sub-Bloc Driver MC33153 & IGBT APT75GT120JU2
.subckt sub_driver_igbt PWM_IN VCC_15V GNDD COLLECTOR EMITTER FAULT_OUT
B_DRV GATE_DRV GNDD V=if(V(PWM_IN,GNDD)>2.5, V(VCC_15V,GNDD), 0)
R6 GATE_DRV S_GATE 15
S1 COLLECTOR EMITTER S_GATE GNDD SW_IGBT
C_SNUB COLLECTOR EMITTER 2u
B_FAULT FAULT_OUT GNDD V=if((V(PWM_IN,GNDD)>2.5)&(V(COLLECTOR,EMITTER)>5), 5, 0)
.model SW_IGBT SW(Ron=0.03 Roff=1Meg Vt=4 Vh=0.5)
.ends sub_driver_igbt

