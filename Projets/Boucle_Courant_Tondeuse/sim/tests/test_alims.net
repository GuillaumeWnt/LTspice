* Test Bench des Regulateurs 15V et 5V
V1 vin_24v 0 PULSE(0 24 100u 10u 10u 10m 20m)
X_REG15 vin_24v 0 v15 sub_alim_15v
R_load15 v15 0 150
X_REG5 v15 0 v5 sub_alim_5v
R_load5 v5 0 50

* block definitions
.subckt sub_alim_15v VIN_24V GND VOUT_15V
D1 VIN_24V VIN_FILT 1N4007
C1 VIN_FILT GND 10u
B1 VOUT_15V GND V=limit(V(VIN_FILT,GND)-1.5, 0, 15)
C2 VOUT_15V GND 10u
R2 VOUT_15V GND 2.2k
.ends sub_alim_15v

.subckt sub_alim_5v VIN_15V GND VOUT_5V
C14 VIN_15V GND 10u
B1 VOUT_5V GND V=limit(V(VIN_15V,GND)-1.5, 0, 5)
C3 VOUT_5V GND 10u
R1 VOUT_5V GND 1k
.ends sub_alim_5v

.model 1N4007 D(IS=7.02e-9 RS=0.034 BV=1000 IBV=0.05u)
.tran 5m
.meas tran v15_ss find V(v15) at 4m
.meas tran v5_ss find V(v5) at 4m
.end
