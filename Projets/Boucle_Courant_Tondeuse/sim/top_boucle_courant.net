* SCHEMA MAITRE UNIFIE - EMETTEUR BOUCLE DE COURANT TONDEUSE
V_BAT vbat_24v 0 24
V_PWM_MCU pwm_arduino 0 PULSE(0 5 1m 10u 10u 200u 2m)
X_COMMAND_BOARD v15_rail pwm_arduino v_hall sens_i v5_rail pwm_opto i_max_ok 0 bloc_commande
X_POWER_BOARD vbat_24v pwm_opto boucle_neg v15_rail v_hall sens_i 0 bloc_puissance
L_LOOP vbat_24v P001 500u
R_LOOP P001 boucle_neg 3

* block symbol definitions
.subckt bloc_commande +15V_IN PWM_MCU_IN V_CPT_HALL SENS_I +5V_OUT PWM_OPTO_OUT I_MAX_INT GND
C14 +15V_IN GND 10u
B_REG5 +5V_OUT GND V=limit(V(+15V_IN,GND)-1.5, 0, 5)
C3 +5V_OUT GND 10u
B_OPTO PWM_OPTO_OUT GND V=if((V(PWM_MCU_IN,GND)>2.5)&(V(I_MAX_INT,GND)>2.5), V(+15V_IN,GND), 0)
B_COMP I_MAX_INT GND V=if(V(V_CPT_HALL,GND) > 1.2, 0, 5)
.ends bloc_commande

.subckt bloc_puissance VIN_24V PWM_OPTO_IN -BOUCLE VOUT_15V V_CPT_HALL SENS_I GNDD
D1 VIN_24V N_FILT 1N4007
C1 N_FILT GNDD 10u
B_REG15 VOUT_15V GNDD V=limit(V(N_FILT,GNDD)-1.5, 0, 15)
C2 VOUT_15V GNDD 10u
B_DRV GATE_DRV GNDD V=if(V(PWM_OPTO_IN,GNDD)>2.5, 15, 0)
R_SHUNT -BOUCLE SW_IN 0.002
S_IGBT SW_IN GNDD GATE_DRV GNDD SW_IGBT
B_HALL V_CPT_HALL GNDD V=0.5 + 0.08*I(R_SHUNT)
B_SHUNT SENS_I GNDD V=V(-BOUCLE,GNDD)
.model SW_IGBT SW(Ron=0.03 Roff=1Meg Vt=4 Vh=0.5)
.model 1N4007 D(IS=7.02e-9 RS=0.034 BV=1000 IBV=0.05u)
.ends bloc_puissance

.tran 10m
.meas tran I_loop_max max I(L_LOOP)
.meas tran V15_ss find V(v15_rail) at 8m
.meas tran V5_ss find V(v5_rail) at 8m
.meas tran V_hall_max max V(v_hall)
.end
